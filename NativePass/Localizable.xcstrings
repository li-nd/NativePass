    "When enabled, Quick Access can type the password into the app that was focused before the popup opened.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Quick Access can type the password into the app that was focused before the popup opened."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, Быстрый доступ может ввести пароль в приложение, которое было в фокусе до открытия окна."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, kann der Schnellzugriff das Passwort in die App tippen, die vor dem Popup fokussiert war."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activé, l’accès rapide peut saisir le mot de passe dans l’app qui avait le focus avant l’ouverture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está activado, Acceso rápido puede escribir la contraseña en la app que tenía el foco antes del popup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、ポップアップを開く前にフォーカスされていたアプリにパスワードを自動入力できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，快速访问可将密码键入到弹出窗口打开前处于前台的应用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Acesso rápido pode digitar a senha no app que estava em foco antes do popup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abilitato, Accesso rapido può digitare la password nell’app che aveva il focus prima del popup."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하면 팝업을 열기 전에 포커스된 앱에 비밀번호를 입력할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld kan Sneltoegang het wachtwoord typen in de app die vóór de popup de focus had."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu Szybki dostęp może wpisać hasło w aplikacji, która miała fokus przed otwarciem okna."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо увімкнено, Швидкий доступ може ввести пароль у програму, яка була у фокусі до відкриття вікна."
          }
        }
      }
    },

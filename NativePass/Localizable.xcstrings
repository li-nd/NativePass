    "The GPG agent is not running or cannot be reached. Restart it and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The GPG agent is not running or cannot be reached. Restart it and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG agent не запущен или недоступен. Перезапустите его и повторите попытку."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der GPG-Agent läuft nicht oder ist nicht erreichbar. Starten Sie ihn neu und versuchen Sie es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agent GPG ne fonctionne pas ou est inaccessible. Redémarrez-le et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente GPG no está en ejecución o no es accesible. Reinícialo e inténtalo de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG エージェントが動作していないか到達できません。再起動して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG agent 未运行或无法访问。请重启后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente GPG não está em execução ou não está acessível. Reinicie e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agente GPG non è in esecuzione o non è raggiungibile. Riavvialo e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG 에이전트가 실행 중이 아니거나 연결할 수 없습니다. 다시 시작한 후 재시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De GPG-agent draait niet of is niet bereikbaar. Start opnieuw en probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent GPG nie działa lub jest niedostępny. Uruchom go ponownie i spróbuj jeszcze raz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG agent не запущено або недоступний. Перезапустіть його та повторіть спробу."
          }
        }
      }
    },
    "This password store is encrypted for a GPG key that is not available on this Mac. Import the matching private key or use the machine where the key already exists.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password store is encrypted for a GPG key that is not available on this Mac. Import the matching private key or use the machine where the key already exists."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это хранилище зашифровано для GPG-ключа, которого нет на этом Mac. Импортируйте нужный закрытый ключ или используйте машину, где ключ уже есть."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Passwort-Store ist für einen GPG-Schlüssel verschlüsselt, der auf diesem Mac nicht verfügbar ist. Importieren Sie den passenden privaten Schlüssel oder nutzen Sie den Rechner, auf dem der Schlüssel bereits vorhanden ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce store est chiffré pour une clé GPG absente sur ce Mac. Importez la clé privée correspondante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este almacén está cifrado para una clave GPG no disponible en este Mac. Importa la clave privada correspondiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このストアは、この Mac にない GPG キーで暗号化されています。対応する秘密鍵をインポートしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此密码库使用本 Mac 上没有的 GPG 密钥加密。请导入匹配的私钥。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este armazenamento está criptografado para uma chave GPG indisponível neste Mac. Importe a chave privada correspondente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo store è cifrato per una chiave GPG non disponibile su questo Mac. Importa la chiave privata corrispondente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스토어는 이 Mac에 없는 GPG 키로 암호화되어 있습니다. 일치하는 개인 키를 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze store is versleuteld voor een GPG-sleutel die niet op deze Mac beschikbaar is. Importeer de bijbehorende privésleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten magazyn jest zaszyfrowany kluczem GPG niedostępnym na tym Macu. Zaimportuj pasujący klucz prywatny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це сховище зашифроване для GPG-ключа, якого немає на цьому Mac. Імпортуйте відповідний закритий ключ."
          }
        }
      }
    },
    "This will permanently remove the entry from your password store.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently remove the entry from your password store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись будет безвозвратно удалена из хранилища паролей."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag wird dauerhaft aus dem Passwort-Store entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement l'entrée de votre store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente la entrada de tu almacén."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリはパスワードストアから完全に削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从密码库中永久删除该条目。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá permanentemente a entrada do seu armazenamento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuoverà definitivamente la voce dallo store password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목이 비밀번호 스토어에서 영구적으로 제거됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert het item permanent uit je wachtwoordstore."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To trwale usunie wpis z magazynu haseł."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис буде остаточно видалено зі сховища паролів."
          }
        }
      }
    },
    "To use Touch ID when decrypting passwords, install pinentry-mac and add to ~/.gnupg/gpg-agent.conf:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use Touch ID when decrypting passwords, install pinentry-mac and add to ~/.gnupg/gpg-agent.conf:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы использовать Touch ID при расшифровке паролей, установите pinentry-mac и добавьте в ~/.gnupg/gpg-agent.conf:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Touch ID beim Entschlüsseln zu nutzen, installieren Sie pinentry-mac und tragen Sie in ~/.gnupg/gpg-agent.conf ein:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour Touch ID lors du déchiffrement, installez pinentry-mac et ajoutez à ~/.gnupg/gpg-agent.conf :"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Touch ID al descifrar, instala pinentry-mac y añade a ~/.gnupg/gpg-agent.conf:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号時に Touch ID を使うには pinentry-mac をインストールし ~/.gnupg/gpg-agent.conf に追加:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密时使用 Touch ID，请安装 pinentry-mac 并添加到 ~/.gnupg/gpg-agent.conf："
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para Touch ID ao descriptografar, instale pinentry-mac e adicione a ~/.gnupg/gpg-agent.conf:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per usare Touch ID durante la decifratura, installa pinentry-mac e aggiungi a ~/.gnupg/gpg-agent.conf:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복호화 시 Touch ID를 사용하려면 pinentry-mac을 설치하고 ~/.gnupg/gpg-agent.conf에 추가하세요:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om Touch ID te gebruiken bij ontsleutelen, installeer pinentry-mac en voeg toe aan ~/.gnupg/gpg-agent.conf:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby używać Touch ID podczas odszyfrowywania, zainstaluj pinentry-mac i dodaj do ~/.gnupg/gpg-agent.conf:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використовувати Touch ID під час розшифрування, встановіть pinentry-mac і додайте до ~/.gnupg/gpg-agent.conf:"
          }
        }
      }
    },

    "Your private key is present but locked. Unlock it once in Terminal, or configure pinentry-mac so NativePass can prompt for your passphrase.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private key is present but locked. Unlock it once in Terminal, or configure pinentry-mac so NativePass can prompt for your passphrase."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрытый ключ есть, но он заблокирован. Разблокируйте его один раз в Terminal или настройте pinentry-mac, чтобы NativePass мог запросить passphrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr privater Schlüssel ist vorhanden, aber gesperrt. Entsperren Sie ihn einmal im Terminal oder konfigurieren Sie pinentry-mac, damit NativePass die Passphrase abfragen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé privée est présente mais verrouillée. Déverrouillez-la dans le Terminal ou configurez pinentry-mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave privada está presente pero bloqueada. Desbloquéala en Terminal o configura pinentry-mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵はありますがロックされています。Terminal で解除するか pinentry-mac を設定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥存在但已锁定。请在终端解锁或配置 pinentry-mac。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave privada está presente, mas bloqueada. Desbloqueie no Terminal ou configure pinentry-mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave privata è presente ma bloccata. Sbloccala nel Terminale o configura pinentry-mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 키는 있지만 잠겨 있습니다. Terminal에서 잠금 해제하거나 pinentry-mac을 구성하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je privésleutel is aanwezig maar vergrendeld. Ontgrendel hem in Terminal of configureer pinentry-mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz prywatny jest obecny, ale zablokowany. Odblokuj go w Terminalu lub skonfiguruj pinentry-mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закритий ключ є, але він заблокований. Розблокуйте його один раз у Terminal або налаштуйте pinentry-mac."
          }
        }
      }
    },

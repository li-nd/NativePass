    "Without this, NativePass cannot show a passphrase dialog.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this, NativePass cannot show a passphrase dialog."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого NativePass не сможет показать диалог passphrase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne dies kann NativePass keinen Passphrase-Dialog anzeigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cela, NativePass ne peut pas afficher de dialogue de passphrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esto, NativePass no puede mostrar un diálogo de passphrase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがないと NativePass はパスフレーズダイアログを表示できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则 NativePass 无法显示口令对话框。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem isso, NativePass não pode mostrar diálogo de passphrase."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza questo, NativePass non può mostrare una finestra di passphrase."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 없으면 NativePass는 패스프레이즈 대화상자를 표시할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder dit kan NativePass geen passphrase-dialoog tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tego NativePass nie może pokazać okna passphrase."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без цього NativePass не зможе показати діалог passphrase."
          }
        }
      }
    },

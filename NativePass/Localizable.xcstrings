    "This password store is encrypted for a GPG key that is not available on this Mac. Import the matching private key or use the machine where the key already exists." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Passwort-Store ist für einen GPG-Schlüssel verschlüsselt, der auf diesem Mac nicht verfügbar ist. Importieren Sie den passenden privaten Schlüssel oder nutzen Sie den Rechner, auf dem der Schlüssel bereits vorhanden ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This password store is encrypted for a GPG key that is not available on this Mac. Import the matching private key or use the machine where the key already exists."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este almacén está cifrado para una clave GPG no disponible en este Mac. Importa la clave privada correspondiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce store est chiffré pour une clé GPG absente sur ce Mac. Importez la clé privée correspondante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo store è cifrato per una chiave GPG non disponibile su questo Mac. Importa la chiave privata corrispondente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このストアは、この Mac にない GPG キーで暗号化されています。対応する秘密鍵をインポートしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 스토어는 이 Mac에 없는 GPG 키로 암호화되어 있습니다. 일치하는 개인 키를 가져오세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze store is versleuteld voor een GPG-sleutel die niet op deze Mac beschikbaar is. Importeer de bijbehorende privésleutel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten magazyn jest zaszyfrowany kluczem GPG niedostępnym na tym Macu. Zaimportuj pasujący klucz prywatny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este armazenamento está criptografado para uma chave GPG indisponível neste Mac. Importe a chave privada correspondente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это хранилище зашифровано для GPG-ключа, которого нет на этом Mac. Импортируйте нужный закрытый ключ или используйте машину, где ключ уже есть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це сховище зашифроване для GPG-ключа, якого немає на цьому Mac. Імпортуйте відповідний закритий ключ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此密码库使用本 Mac 上没有的 GPG 密钥加密。请导入匹配的私钥。"
          }
        }
      }
    },
    "This will permanently remove the entry from your password store." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag wird dauerhaft aus dem Passwort-Store entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently remove the entry from your password store."
          }
        },
        "es" : {
          "stringUnit" : {

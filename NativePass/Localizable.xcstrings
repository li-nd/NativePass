    "GPG could not decrypt this entry. Try the steps below or open Diagnostics for more details.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG could not decrypt this entry. Try the steps below or open Diagnostics for more details."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG не смог расшифровать эту запись. Выполните шаги ниже или откройте Диагностику для подробностей."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG konnte diesen Eintrag nicht entschlüsseln. Folgen Sie den Schritten unten oder öffnen Sie die Diagnose für mehr Details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG n'a pas pu déchiffrer cette entrée. Suivez les étapes ou ouvrez Diagnostics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG no pudo descifrar esta entrada. Prueba los pasos o abre Diagnóstico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG はこのエントリを復号できませんでした。手順を試すか、診断を開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG 无法解密此条目。请尝试以下步骤或打开诊断。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GPG não conseguiu descriptografar esta entrada. Tente os passos ou abra Diagnóstico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG non è riuscito a decifrare questa voce. Prova i passaggi sotto o apri Diagnostica."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG가 이 항목을 복호화하지 못했습니다. 아래 단계를 시도하거나 진단을 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG kon dit item niet ontsleutelen. Volg de stappen of open Diagnose."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG nie mógł odszyfrować tego wpisu. Spróbuj poniższych kroków lub otwórz Diagnostykę."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "GPG не зміг розшифрувати цей запис. Виконайте кроки нижче або відкрийте Діагностику."
          }
        }
      }
    },
    "GPG did not receive a passphrase. Try again when you're ready to unlock your key.": {

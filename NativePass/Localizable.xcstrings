    "The GPG agent is not running or cannot be reached. Restart it and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der GPG-Agent läuft nicht oder ist nicht erreichbar. Starten Sie ihn neu und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The GPG agent is not running or cannot be reached. Restart it and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente GPG no está en ejecución o no es accesible. Reinícialo e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

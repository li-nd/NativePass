    "Your private key is present but locked. Unlock it once in Terminal, or configure pinentry-mac so NativePass can prompt for your passphrase." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr privater Schlüssel ist vorhanden, aber gesperrt. Entsperren Sie ihn einmal im Terminal oder konfigurieren Sie pinentry-mac, damit NativePass die Passphrase abfragen kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your private key is present but locked. Unlock it once in Terminal, or configure pinentry-mac so NativePass can prompt for your passphrase."
          }
        },
        "es" : {
          "stringUnit" : {

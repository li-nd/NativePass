    "Uses Touch ID or device password to unlock the app UI. GPG decryption still uses pinentry-mac.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Touch ID or device password to unlock the app UI. GPG decryption still uses pinentry-mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для разблокировки интерфейса используются Touch ID или пароль устройства. Расшифровка GPG по-прежнему через pinentry-mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Entsperren der App-Oberfläche werden Touch ID oder das Gerätepasswort verwendet. Die GPG-Entschlüsselung nutzt weiterhin pinentry-mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise Touch ID ou le mot de passe de l'appareil pour déverrouiller l'UI. Le déchiffrement GPG utilise toujours pinentry-mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Touch ID o la contraseña del dispositivo para desbloquear la UI. GPG sigue usando pinentry-mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ UI のロック解除に Touch ID またはデバイスパスワードを使用します。GPG 復号は pinentry-mac を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Touch ID 或设备密码解锁应用界面。GPG 解密仍使用 pinentry-mac。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Touch ID ou a senha do dispositivo para desbloquear a UI. GPG ainda usa pinentry-mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Touch ID o la password del dispositivo per sbloccare l'UI. La decifratura GPG usa ancora pinentry-mac."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 UI 잠금 해제에 Touch ID 또는 기기 암호를 사용합니다. GPG 복호화는 계속 pinentry-mac을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt Touch ID of het apparaatwachtwoord om de UI te ontgrendelen. GPG-ontsleuteling gebruikt nog steeds pinentry-mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa Touch ID lub hasła urządzenia do odblokowania UI. Odszyfrowanie GPG nadal używa pinentry-mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для розблокування інтерфейсу використовуються Touch ID або пароль пристрою. Розшифрування GPG і далі через pinentry-mac."
          }
        }
      }
    },

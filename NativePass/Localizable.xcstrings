    "System follows macOS language. Other choices override it for NativePass.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows macOS language. Other choices override it for NativePass."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системный» следует языку macOS. Другие варианты переопределяют его для NativePass."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„System“ folgt der macOS-Sprache. Andere Optionen überschreiben sie für NativePass."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Système » suit la langue de macOS. Les autres choix la remplacent pour NativePass."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el idioma de macOS. Otras opciones lo anulan en NativePass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム」は macOS の言語に従います。他の選択は NativePass のみ上書きします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“系统”跟随 macOS 语言。其他选项仅覆盖 NativePass。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Sistema” segue o idioma do macOS. Outras opções substituem apenas no NativePass."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» segue la lingua di macOS. Le altre scelte la sostituiscono per NativePass."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘시스템’은 macOS 언어를 따릅니다. 다른 선택은 NativePass에만 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Systeem’ volgt de macOS-taal. Andere keuzes overschrijven die voor NativePass."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Systemowy” podąża za językiem macOS. Inne opcje nadpisują go w NativePass."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Системна» відповідає мові macOS. Інші варіанти перевизначають її для NativePass."
          }
        }
      }
    },

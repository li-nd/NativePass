          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To trwale usunie wpis z magazynu haseł."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso removerá permanentemente a entrada do seu armazenamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",

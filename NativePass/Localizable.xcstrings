    "macOS requires Accessibility access before Auto-Type can work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS requires Accessibility access before Auto-Type can work."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS требует доступ к Универсальному доступу, чтобы автонабор работал."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS benötigt Zugang zu den Bedienungshilfen, damit Auto-Type funktioniert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS exige l’accès à l’Accessibilité pour que la saisie auto fonctionne."
          }
        },
